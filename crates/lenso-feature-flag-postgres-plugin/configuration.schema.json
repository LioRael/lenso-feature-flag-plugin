{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PostgreSQL Feature Flag Plugin configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "database_url_secret", "auth_issuer", "auth_assertion_public_key", "evaluation_callers", "admin_callers", "max_context_bytes", "max_attributes", "max_batch_size"],
  "properties": {
    "schema": { "type": "string", "minLength": 1, "maxLength": 63 },
    "database_url_secret": { "type": "string", "minLength": 1, "maxLength": 256 },
    "auth_issuer": { "type": "string", "minLength": 1, "maxLength": 256 },
    "auth_assertion_public_key": { "type": "string", "minLength": 1, "maxLength": 256 },
    "evaluation_callers": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "admin_callers": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "max_context_bytes": { "type": "integer", "minimum": 256, "maximum": 65536 },
    "max_attributes": { "type": "integer", "minimum": 1, "maximum": 64 },
    "max_batch_size": { "type": "integer", "minimum": 1, "maximum": 100 }
  }
}
